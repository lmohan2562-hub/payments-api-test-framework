<configuration>
    <!-- Structured, logfmt-style lines: easy to grep locally and to ingest in a log pipeline. -->
    <property name="PATTERN"
              value="ts=%d{yyyy-MM-dd'T'HH:mm:ss.SSS} level=%-5level thread=%thread logger=%logger{0} %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${PATTERN}</pattern>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.FileAppender">
        <file>target/logs/test-run.log</file>
        <append>false</append>
        <encoder>
            <pattern>${PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- Headers/bodies (already masked) go to the file at DEBUG; console stays concise. -->
    <logger name="payments.http" level="DEBUG" additivity="false">
        <appender-ref ref="FILE"/>
    </logger>

    <!-- Third-party noise -->
    <logger name="org.eclipse.jetty" level="WARN"/>
    <logger name="wiremock" level="WARN"/>
    <logger name="com.github.tomakehurst.wiremock" level="WARN"/>
    <logger name="org.apache.http" level="WARN"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>
