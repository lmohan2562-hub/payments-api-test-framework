{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "AuthorizationResponse",
  "type": "object",
  "required": ["authorizationId", "status", "merchantId", "amount", "refundableAmount", "createdAt"],
  "additionalProperties": false,
  "properties": {
    "authorizationId": { "type": "string", "pattern": "^auth_[a-f0-9]{24}$" },
    "status": { "type": "string", "enum": ["APPROVED", "DECLINED"] },
    "merchantId": { "type": "string", "pattern": "^MRC-[A-Z0-9-]{4,32}$" },
    "reference": { "type": "string", "maxLength": 64 },
    "amount": { "$ref": "#/definitions/money" },
    "refundableAmount": { "$ref": "#/definitions/money" },
    "declineCode": { "type": "string", "pattern": "^[0-9]{2}$" },
    "declineReason": { "type": "string" },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "definitions": {
    "money": {
      "type": "object",
      "required": ["value", "currency"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": "integer", "minimum": 0 },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
      }
    }
  }
}
