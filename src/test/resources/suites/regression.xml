<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Full regression: every group, test classes run in parallel. -->
<suite name="payments-api-regression" parallel="classes" thread-count="4" verbose="1">
    <listeners>
        <listener class-name="io.github.lehamohan.payments.support.TestEnvironment"/>
    </listeners>
    <test name="regression">
        <groups>
            <run>
                <include name="regression"/>
            </run>
        </groups>
        <packages>
            <package name="io.github.lehamohan.payments.unit"/>
            <package name="io.github.lehamohan.payments.tests"/>
        </packages>
    </test>
</suite>
