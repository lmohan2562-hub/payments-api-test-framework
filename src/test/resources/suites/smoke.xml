<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Fast gate for every push: critical paths only. Run with: mvn verify -Dsuite=smoke -->
<suite name="payments-api-smoke" parallel="classes" thread-count="4" verbose="1">
    <listeners>
        <listener class-name="io.github.lehamohan.payments.support.TestEnvironment"/>
    </listeners>
    <test name="smoke">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <packages>
            <package name="io.github.lehamohan.payments.unit"/>
            <package name="io.github.lehamohan.payments.tests"/>
        </packages>
    </test>
</suite>
